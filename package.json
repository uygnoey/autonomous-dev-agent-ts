{
  "name": "autonomous-dev-agent",
  "version": "1.0.0",
  "description": "Claude Code Skills + RAG autonomous development agent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./rag": {
      "types": "./dist/rag/index.d.ts",
      "import": "./dist/rag/index.js",
      "default": "./dist/rag/index.js"
    },
    "./layer1": {
      "types": "./dist/layer1/index.d.ts",
      "import": "./dist/layer1/index.js",
      "default": "./dist/layer1/index.js"
    },
    "./layer2": {
      "types": "./dist/layer2/index.d.ts",
      "import": "./dist/layer2/index.js",
      "default": "./dist/layer2/index.js"
    },
    "./layer3": {
      "types": "./dist/layer3/index.d.ts",
      "import": "./dist/layer3/index.js",
      "default": "./dist/layer3/index.js"
    }
  },
  "bin": {
    "adev": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uygnoey/autonomous-dev-agent-ts.git"
  },
  "homepage": "https://github.com/uygnoey/autonomous-dev-agent-ts#readme",
  "bugs": {
    "url": "https://github.com/uygnoey/autonomous-dev-agent-ts/issues"
  },
  "author": "uygnoey",
  "license": "MIT",
  "keywords": [
    "autonomous",
    "agent",
    "claude",
    "anthropic",
    "rag",
    "vector-db",
    "lancedb",
    "development",
    "automation",
    "ai",
    "typescript",
    "bun"
  ],
  "files": [
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts src/core/index.ts src/rag/index.ts src/layer1/index.ts src/layer2/index.ts src/layer3/index.ts --outdir ./dist --target bun --splitting --external @lancedb/lancedb --external @huggingface/transformers",
    "build:types": "bunx tsc -p tsconfig.build.json",
    "postinstall": "echo '\\n[adev] 네이티브 바이너리 설치를 위해 bun install을 실행하세요. / Run bun install for native binaries.\\n'",
    "prepublishOnly": "bun run typecheck && bun run lint",
    "test": "bun run test:unit && bun run test:module && bun run test:e2e",
    "test:coverage": "bun test --coverage tests/unit/",
    "test:unit": "bun test tests/unit/",
    "test:module": "bun test tests/module/cli-integration.test.ts tests/module/core-auth.test.ts tests/module/core-mcp.test.ts tests/module/layer1-rag.test.ts tests/module/layer2-auth.test.ts tests/module/layer2-layer1.test.ts tests/module/layer3-layer2.test.ts && bash scripts/test-lancedb.sh tests/module/core-rag.test.ts",
    "test:e2e": "bash scripts/test-lancedb.sh tests/e2e/",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check src/",
    "format": "bunx biome format src/ --write",
    "check": "bun run typecheck && bun run lint && bun run test",
    "docs": "bunx typedoc",
    "docs:watch": "bunx typedoc --watch"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.72",
    "@anthropic-ai/claude-code": "^0.2.63",
    "@anthropic-ai/sdk": "^0.78.0",
    "@huggingface/transformers": "^3.0.0",
    "@lancedb/lancedb": "^0.15.0",
    "docx": "^9.6.1",
    "handlebars": "^4.7.8",
    "inquirer": "^13.3.0",
    "pdfkit": "^0.17.2",
    "pptxgenjs": "^4.0.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "@types/handlebars": "^4.1.0",
    "@types/inquirer": "^9.0.9",
    "@types/pdfkit": "^0.17.5",
    "@types/yargs": "^17.0.35",
    "typedoc": "^0.27.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20 <99"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
