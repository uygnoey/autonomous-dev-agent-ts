      ],
      "fix_files": ["src/cli/main.ts", "src/index.ts"],
      "fix_description": [
        "main.ts: 'config <sub>' → 'config <sub> [args..]', 'setting <sub>' → 'setting <sub> [args..]'",
        "main.ts: .parserConfiguration({'dot-notation': false}) 추가",
        "index.ts: config 핸들러 args 조합을 parsed.args 기반으로 수정 (project 핸들러 패턴 적용)"
      ],
      "status": "resolved"
