  "keyFileState": {
    "file": "src/layer2/v2-session-executor.ts",
    "method": "buildSessionEnvironment",
    "currentLogic": [
      "1. const baseEnv = { ...(process.env as Record<string, string>) }  // 시스템 환경변수 전체 복사",
      "2. if 'x-api-key' in authHeader → baseEnv.ANTHROPIC_API_KEY = authHeader['x-api-key']  // API Key 오버라이드",
      "3. if 'authorization' in authHeader → baseEnv.CLAUDE_CODE_OAUTH_TOKEN = token  // OAuth Token 추가",
      "4. delete baseEnv.CLAUDECODE  // nested session 방지 (핵심!)",
      "5. return { ...baseEnv, ...(config.env ?? {}) }  // config.env가 최종 오버라이드"
    ],
    "whyEachStep": {
      "step1": "SDK env 파라미터는 process.env를 완전 대체하므로, PATH/HOME 등 필수 시스템 환경변수를 보존하기 위해 base로 복사",
      "step4": "adev가 Claude Code 세션 안에서 실행되므로 CLAUDECODE가 설정되어 있음. 이를 서브프로세스에 전달하면 nested session 에러로 exit code 1 종료"
    }
  },
