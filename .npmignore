# adev .npmignore — publish 시 제외 목록

tests/
docs/
claudedocs/
scripts/
.claude/
relative-test/
poc/
adev-spec-full-v2_4.md
tsconfig.json
biome.json
bun.lock
ARCHITECTURE.md
SPEC.md
IMPLEMENTATION-GUIDE.md
CLAUDE.md
PROGRESS.md
README.es.md
README.ja.md
README.ko.md

# 네이티브 바이너리 제외 / Exclude native binaries from npm publish
# WHY: @lancedb/lancedb and @huggingface/transformers install platform-specific
# .node addons via their own optionalDependencies at `bun install` time.
# bun build externalises both packages (--external) so .node files should never
# appear in dist/, but this glob is a belt-and-suspenders guard.
dist/*.node
dist/**/*.node
